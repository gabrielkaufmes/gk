{
  "name": "logistic-optimizer",
  "version": "0.1.0",
  "description": "Logistic Optimizer — Electron desktop app for Elwiz",
  "main": "electron/main.cjs",
  "author": "Gabriel Kaufmes",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.elwiz.logisticoptimizer",
    "productName": "Logistic Optimizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
