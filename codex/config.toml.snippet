# Append to ~/.codex/config.toml (the shadcn CLI cannot edit this file for you).
# Then run `npx shadcn@latest mcp init --client codex` in the project and restart Codex.

[mcp_servers.shadcn]
command = "npx"
args = ["shadcn@latest", "mcp"]

# Optional: Magic UI registry browser
[mcp_servers.magicui]
command = "npx"
args = ["-y", "@magicuidesign/mcp@latest"]

# Optional: 21st MCP (free key at https://21st.dev/mcp; keep the key out of git)
# Prefer `npx @21st-dev/cli@latest init --client codex`, which writes this for you.
# [mcp_servers."21st"]
# url = "https://21st.dev/api/mcp"
# http_headers = { "x-api-key" = "YOUR_21ST_API_KEY" }
